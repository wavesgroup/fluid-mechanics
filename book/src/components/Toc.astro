---
import katex from "katex";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
const mathParts = (text: string) => text.split(/(\$[^$\n]+\$)/g).filter(Boolean);
---

{items.length > 0 && (
  <nav class="toc" aria-label="On this page">
    <h2>In this chapter</h2>
    <ol>
      {items.map((h) => (
        <li>
          <a class={h.depth === 3 ? "toc-h3" : undefined} href={`#${h.slug}`}>
            {mathParts(h.text).map((part) =>
              part.startsWith("$") && part.endsWith("$") ? (
                <Fragment set:html={katex.renderToString(part.slice(1, -1), { throwOnError: false, strict: "ignore" })} />
              ) : (
                part
              ),
            )}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}
