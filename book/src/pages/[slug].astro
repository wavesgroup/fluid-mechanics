---
import { render } from "astro:content";
import Chapter from "../layouts/Chapter.astro";
import { allChapters, chapterHref } from "../lib/nav";

export async function getStaticPaths() {
  const chapters = await allChapters();
  return chapters.map((ch, i) => ({
    params: { slug: ch.id },
    props: {
      ch,
      prev: i > 0 ? chapters[i - 1] : null,
      next: i < chapters.length - 1 ? chapters[i + 1] : null,
    },
  }));
}

const { ch, prev, next } = Astro.props;
const { Content, headings } = await render(ch);
// Astro collects heading text after KaTeX has expanded inline math, so its
// text contains both the visible glyph and the MathML/TeX accessibility text.
// Use the Markdown source for TOC labels when a heading contains inline math.
const sectionHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const sourceHeadings = [...ch.body.matchAll(/^(#{2,3})[ \t]+(.+?)\s*$/gm)];
const tocHeadings = sectionHeadings.map((heading, index) => {
  const source = sourceHeadings[index];
  if (source && source[1].length === heading.depth && source[2].includes("$")) {
    return { ...heading, text: source[2] };
  }
  return heading;
});
const kicker =
  ch.data.kind === "appendix"
    ? `Appendix ${ch.data.number}`
    : ch.data.kind === "front"
      ? "Front matter"
      : undefined;
---

<Chapter
  title={ch.data.title}
  number={ch.data.kind === "chapter" ? ch.data.number : null}
  kicker={kicker}
  secId={ch.data.label}
  headings={tocHeadings}
  prev={prev ? { href: chapterHref(prev), title: prev.data.title } : { href: "/", title: "Home" }}
  next={next ? { href: chapterHref(next), title: next.data.title } : { href: "/references", title: "References" }}
>
  <Content />
</Chapter>
